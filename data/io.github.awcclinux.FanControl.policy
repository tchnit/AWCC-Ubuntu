<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Alienware Control Center for Linux</vendor>
  <action id="io.github.awcclinux.ControlCenter.fan-session">
    <description>Start a bounded Alienware AWCC fan boost session</description>
    <message>Authentication is required for a temporary Custom fan session with automatic recovery</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/awcc-fan-helper</annotate>
  </action>
</policyconfig>
